# Backend environment example

# Port the Express server listens on.
# IMPORTANT: The deployment orchestrator expects the backend on 3001.
PORT=3001

# Host interface to bind the server. Use 0.0.0.0 in containers.
HOST=0.0.0.0

# Allowed CORS origins (comma-separated). Example for local React app:
# For local frontend expected at http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional: Simulated blockchain network label
BLOCKCHAIN_NETWORK=polygon-mumbai

# OTP expiration in seconds
OTP_TTL_SECONDS=300

# Node environment: development | production | test
NODE_ENV=development
