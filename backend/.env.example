# Government Tourism Portal - Backend (.env.example)

# Server binding
# HOST should be 0.0.0.0 to accept connections in containers and remote previews.
HOST=0.0.0.0
# Backend API port. Default and required by the project: 3001
PORT=3001

# Environment
# NODE_ENV can be "development" or "production"
NODE_ENV=development

# CORS: comma-separated list of allowed origins.
# For local development with the React frontend (default on 3000):
CORS_ORIGINS=http://localhost:3000

# OTP settings
# Default TTL for OTP codes (in seconds)
OTP_TTL_SECONDS=300

# Simulated blockchain network name for digital tourist ID minting
BLOCKCHAIN_NETWORK=polygon-mumbai
